# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Public address of this website (used for canonical links, sitemap and social previews).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Enquiry form → Moksha admin panel "Leads" inbox (server-side only; never exposed to the browser) ---
# Base URL of the admin API, e.g. https://moksha-api-b5pt.onrender.com  (local: http://localhost:4000)
ADMIN_API_URL=""
# Must equal PUBLIC_LEADS_API_KEY on the admin API.
PUBLIC_LEADS_API_KEY=""
