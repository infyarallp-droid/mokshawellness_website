# Copy to .env.local for local development. On Vercel: Project → Settings → Environment Variables.
# Only NEXT_PUBLIC_* values ever reach the browser; everything else stays on the server.

# Public address of this website (canonical links, sitemap, Google sign-in redirect).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Moksha admin API (content, accounts, payments, enquiries) ---
# Base URL of the admin API, e.g. https://api.mokshawellness.in  (local: http://localhost:4000)
ADMIN_API_URL=""
# Must equal PUBLIC_LEADS_API_KEY on the admin API (enquiry form → Leads inbox).
PUBLIC_LEADS_API_KEY=""
# Must equal WEBSITE_SERVICE_KEY on the admin API. Long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBSITE_SERVICE_KEY=""
# Must equal WEBSITE_REVALIDATE_SECRET on the admin API (refreshes pages right after an admin publishes).
REVALIDATE_SECRET=""

# --- Continue with Google (optional; the button is hidden until both are set) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
# The same client id goes into GOOGLE_CLIENT_ID on the admin API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
